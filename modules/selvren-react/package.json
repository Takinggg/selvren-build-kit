{
  "name": "@selvren/react",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Composants React accessibles pour un agent Selvren. Non publié.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./css/styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "css", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.17",
