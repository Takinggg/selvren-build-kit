# Publishable Clerk key of the SAME Clerk instance as the Selvren API.
# Never put sk_*, selvren_int_* or selvren_private_* here.
VITE_CLERK_PUBLISHABLE_KEY=

# HTTPS origin of the Selvren API (HTTP only on loopback). No path, query, hash or userinfo.
VITE_SELVREN_API_ORIGIN=

# Published agent id: agt_ + 32 lowercase hex. Grants are created server-side.
VITE_SELVREN_AGENT_ID=
